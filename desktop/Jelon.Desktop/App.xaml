<Application x:Class="Jelon.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0F14"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#111821"/>
    <SolidColorBrush x:Key="Panel2Brush" Color="#17212C"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F2F6FA"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8C9AAA"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#5EA7FF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#263443"/>
  </Application.Resources>
</Application>
