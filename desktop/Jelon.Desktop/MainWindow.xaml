<Window x:Class="Jelon.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jelon" Width="1180" Height="760"
        MinWidth="900" MinHeight="600"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="210"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="270"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#0E141B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <StackPanel Margin="18">
        <TextBlock Text="JELON" FontSize="25" FontWeight="Bold"/>
        <TextBlock Text="LOCAL AI AGENT" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,30"/>
        <Button Content="Chat" Height="42" Margin="0,0,0,8" Background="{StaticResource Panel2Brush}" Foreground="{StaticResource TextBrush}" BorderThickness="0"/>
        <Button Content="Activity" Height="42" Margin="0,0,0,8" Background="Transparent" Foreground="{StaticResource MutedBrush}" BorderThickness="0"/>
        <Button Content="Memory" Height="42" Margin="0,0,0,8" Background="Transparent" Foreground="{StaticResource MutedBrush}" BorderThickness="0"/>
        <Button Content="Settings" Height="42" Background="Transparent" Foreground="{StaticResource MutedBrush}" BorderThickness="0"/>
        <Border Margin="0,35,0,0" Padding="12" Background="{StaticResource PanelBrush}" CornerRadius="8">
          <StackPanel>
            <TextBlock Text="CORE STATUS" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock x:Name="CoreStatusText" Text="Starting…" Margin="0,5,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <Grid Grid.Column="1" Margin="26,20,20,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0">
        <TextBlock Text="What can I do for you?" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="Jelon plans, acts, observes and verifies locally." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,18"/>
      </StackPanel>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ChatPanel"/>
      </ScrollViewer>

      <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,15,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="90"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="InputBox" Grid.Column="0" MinHeight="48" AcceptsReturn="True"
                   TextWrapping="Wrap" Background="Transparent" Foreground="{StaticResource TextBrush}"
                   BorderThickness="0" Padding="8" VerticalContentAlignment="Center"
                   KeyDown="InputBox_KeyDown"/>
          <Button x:Name="SendButton" Grid.Column="1" Content="SEND" Margin="10,0,0,0"
                  Click="SendButton_Click" Background="{StaticResource AccentBrush}"
                  Foreground="#081019" BorderThickness="0" FontWeight="Bold"/>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Column="2" Background="#0E141B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="18">
      <StackPanel>
        <TextBlock Text="ACTIVITY" FontSize="12" FontWeight="Bold"/>
        <TextBlock Text="Live core events" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,15"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Height="620">
          <StackPanel x:Name="ActivityPanel"/>
        </ScrollViewer>
      </StackPanel>
    </Border>
  </Grid>
</Window>
